{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "stream",
  // Set this to today's date
  "compatibility_date": "2026-03-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // OpenNext persistent cache (see open-next.config.ts and https://opennext.js.org/cloudflare/caching).
  // Self-reference used by the DO queue to revalidate ISR pages; the service name must match "name".
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "stream" }
  ],
  // Workers KV holds the incremental cache (free plan, no payment method). The id is the
  // namespace created with: npx wrangler kv namespace create NEXT_INC_CACHE_KV
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "97061c69cd8b42b48a00391c355bbf5e" }
  ],
  // DOQueueHandler is exported by the generated .open-next/worker.js.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ]
}
