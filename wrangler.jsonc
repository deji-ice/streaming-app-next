{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "stream",
  // Set this to today's date
  "compatibility_date": "2026-03-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // OpenNext cache (see open-next.config.ts). The incremental cache is in-memory, so there is
  // deliberately no KV or R2 binding here: both bill per operation with no cap on a paid plan.
  // Self-reference used by the DO queue to revalidate ISR pages; the service name must match "name".
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "stream" }
  ],
  // DOQueueHandler is exported by the generated .open-next/worker.js.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  // Workers Logs. A deploy overwrites whatever the dashboard's Observability settings say,
  // so the setting lives here. Workers Paid includes 20M log events a month, then $0.60 per
  // million. Logging 1 request in 10 is about 1M a month at Nov 2026 traffic, so it costs
  // nothing extra. Raise the rate only with the bill in mind.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    }
  }
}
